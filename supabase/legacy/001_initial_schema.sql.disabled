-- PRODUCTION STARTER ONLY. Review with a database/security engineer before deployment.
create extension if not exists pgcrypto;
create type public.app_role as enum ('customer','agent','admin');
create type public.insurance_type as enum ('PI','PL','GPA');
create type public.application_status as enum ('draft','submitted','under_review','correction_required','verified','sent_to_generali','completed','rejected');

create table public.profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  full_name text not null,
  role public.app_role not null default 'customer',
  created_at timestamptz not null default now()
);
create table public.agent_customer_access (
  agent_id uuid not null references public.profiles(id),
  customer_id uuid not null references public.profiles(id),
  created_at timestamptz not null default now(),
  primary key(agent_id, customer_id)
);
create table public.guest_links (
  id uuid primary key default gen_random_uuid(),
  token_hash text unique not null,
  form_type public.insurance_type not null,
  expires_at timestamptz not null,
  revoked_at timestamptz,
  used_at timestamptz,
  created_by uuid references public.profiles(id),
  created_at timestamptz not null default now()
);
create table public.applications (
  id uuid primary key default gen_random_uuid(),
  reference_no text unique not null,
  customer_id uuid references public.profiles(id),
  guest_link_id uuid references public.guest_links(id),
  assigned_agent_id uuid references public.profiles(id),
  insurance_type public.insurance_type not null,
  status public.application_status not null default 'draft',
  language text not null default 'en' check(language in ('en','ms')),
  template_version text not null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
create table public.application_answers (
  id uuid primary key default gen_random_uuid(),
  application_id uuid not null references public.applications(id) on delete cascade,
  field_key text not null,
  answer jsonb,
  updated_at timestamptz not null default now(),
  unique(application_id,field_key)
);
create table public.documents (
  id uuid primary key default gen_random_uuid(),
  application_id uuid not null references public.applications(id) on delete cascade,
  object_path text not null unique,
  document_kind text not null,
  mime_type text not null,
  size_bytes bigint not null check(size_bytes > 0),
  sha256 text not null,
  created_at timestamptz not null default now()
);
create table public.application_events (
  id uuid primary key default gen_random_uuid(),
  application_id uuid not null references public.applications(id) on delete cascade,
  actor_id uuid references public.profiles(id),
  old_status text,
  new_status text not null,
  note text,
  created_at timestamptz not null default now()
);

alter table public.profiles enable row level security;
alter table public.agent_customer_access enable row level security;
alter table public.applications enable row level security;
alter table public.application_answers enable row level security;
alter table public.documents enable row level security;
alter table public.application_events enable row level security;
alter table public.guest_links enable row level security;

create policy "profile self read" on public.profiles for select to authenticated using (id = (select auth.uid()));
create policy "customer reads own applications" on public.applications for select to authenticated using (customer_id = (select auth.uid()));
create policy "assigned agent reads applications" on public.applications for select to authenticated using (
  assigned_agent_id = (select auth.uid()) and exists (
    select 1 from public.profiles p where p.id = (select auth.uid()) and p.role in ('agent','admin')
  )
);
create policy "customer creates own draft" on public.applications for insert to authenticated with check (
  customer_id = (select auth.uid()) and status = 'draft'
);
create policy "customer updates own draft or correction" on public.applications for update to authenticated
using (customer_id = (select auth.uid()) and status in ('draft','correction_required'))
with check (customer_id = (select auth.uid()) and status in ('draft','correction_required'));
create policy "answers follow application access" on public.application_answers for select to authenticated using (
  exists(select 1 from public.applications a where a.id = application_id and
    (a.customer_id = (select auth.uid()) or a.assigned_agent_id = (select auth.uid())))
);
create policy "documents follow application access" on public.documents for select to authenticated using (
  exists(select 1 from public.applications a where a.id = application_id and
    (a.customer_id = (select auth.uid()) or a.assigned_agent_id = (select auth.uid())))
);
create policy "events follow application access" on public.application_events for select to authenticated using (
  exists(select 1 from public.applications a where a.id = application_id and
    (a.customer_id = (select auth.uid()) or a.assigned_agent_id = (select auth.uid())))
);

-- Guest-link creation/validation and sensitive agent status changes must run through
-- server-only RPC/API using a restricted DB role. Do not expose service-role keys.
-- Do not create anon policies for raw customer data or private storage objects.
